# Copy this file to .env.local for local development (.env.local is gitignored).
# In production, set these as Environment Variables in the Vercel dashboard instead.

# Azure AI Foundry "Project endpoint" for your model-router deployment
AZURE_AI_ENDPOINT=https://your-resource.services.ai.azure.com/openai/v1

# API key from the same Foundry deployment page
AZURE_AI_API_KEY=

# Deployment name (defaults to "model-router" if unset)
AZURE_AI_DEPLOYMENT=model-router
